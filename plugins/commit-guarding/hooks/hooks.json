{
  "description": "管两件事：提交信息必须单行且带 feat、fix、docs 等类型前缀；提交或推送前先拉最新、解决冲突。svn commit 落后或有冲突时拦下，git commit 与 git push 落后或分叉时拦下",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/svn-commit-guard.sh\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-commit-guard.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
